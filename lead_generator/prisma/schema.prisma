generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id    Int     @id @default(autoincrement())
  auth0_id     String @unique
  name String
  user_jobs User_Job[]
}

model Jobs {
  id    Int     @id @default(autoincrement())
  job_name String
  address String
  job_description String
  estimated_cost Int
  job_type String
  contact_info String   
  created_at DateTime
  user_jobs User_Job[]
}

model User_Job {
  user Users @relation(fields: [user_id], references: [id])
  user_id Int 
  job Jobs @relation(fields: [job_id], references: [id])
  job_id Int
  job_state String                
  contacted Boolean @default(value: false)

  @@unique([user_id, job_id])
}